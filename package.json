{
  "name": "jabol",
  "version": "0.1.8",
  "description": "Just A Bunch Of Links — self-hostable JSON-driven link directory",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "concurrently -k -n server,spa -c blue,magenta \"pnpm:dev:server\" \"pnpm:dev:spa\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:spa": "vite",
    "build": "pnpm build:spa && pnpm build:server",
    "build:spa": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node server-dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "schema:generate": "tsx scripts/generate-schema.ts",
    "schema:check": "tsx scripts/generate-schema.ts --check"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.1.0",
    "@hono/node-server": "^1.13.0",
    "@iconify/react": "^5.0.2",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "better-auth": "^1.2.0",
    "better-sqlite3": "^12.0.0",
    "chokidar": "^4.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.0.0",
    "hono": "^4.6.0",
    "lucide-react": "^0.469.0",
    "p-limit": "^6.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
