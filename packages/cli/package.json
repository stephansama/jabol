{
  "name": "jabol",
  "version": "0.1.16",
  "description": "Generate a static link-directory site from a links.json — the SSG for jabol.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "jabol": "./dist/cli.js"
  },
  "files": [
    "dist",
    "client"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["ssg", "static-site-generator", "links", "directory", "bookmarks"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle-client": "node scripts/bundle-client.mjs",
    "prepack": "pnpm --filter @jabol/core build && pnpm run build && pnpm run bundle-client"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/fira-code": "^5.1.0",
    "@iconify/react": "^5.0.2",
    "@jabol/core": "workspace:*",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.0.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.0.0",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@jabol/client": "workspace:*"
  }
}
